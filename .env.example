TYPESAFE_API_KEY=
FAL_KEY=

# Calling backend only; use the actor URL from terse deploy and a Terse API token.
# npm run host:cloud and dev:cloud use these. Ordinary development starts a local runtime.
TERSE_ACTOR_URL=
TERSE_API_KEY=

# auto enables intelligent interviews when Jev and fal are configured.
# live requires those credentials; authored disables model conversations for tests.
AI_MODE=auto
JEV_MODEL=jev-latest
CHARACTER_MODEL=google/gemini-3.8-flash
CHARACTER_REASONING_EFFORT=medium
# Dialogue uses this model through fal's OpenRouter endpoint, billed to FAL_KEY.
# Microphone transcription uses ElevenLabs Scribe v2 through FAL_KEY.
# Optional JSON object mapping character voice names/inspector IDs to fal voices.
# FAL_VOICES={"reed":"George","ellis":"Harry","Brian":"Daniel"}
