{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 360,
      "includeFiles": "stories/sixth-murder/{story.json,assets/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
